{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/test.tsbuildinfo"
  },
  "include": [
    "src/vite-env.d.ts",
    "vitest.browser.setup.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
